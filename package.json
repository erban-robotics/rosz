{
  "name": "@erban-robotics/rosz-ui",
  "version": "0.2.0",
  "description": "rosz 共享可视化 UI 包: 数据源状态, 播放时钟与回放 / 实时查看面板",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/erban-robotics/rosz-ui"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rosz-ui.css": "./dist/rosz-ui.css",
    "./theme.css": "./dist/theme.css"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && vite build && cp src/rosz-ui.css src/theme.css dist/",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "tsc -b && eslint . && vitest run"
  },
  "peerDependencies": {
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.185.1"
  },
  "dependencies": {
    "@erban-robotics/rosz-wasm": "https://github.com/erban-robotics/rosz/releases/download/v0.1.0/erban-robotics-rosz-wasm-0.1.0.tgz",
    "@react-three/drei": "^10.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react-resizable-panels": "4.19.1",
    "tailwind-merge": "^3.7.0",
    "uplot": "^1.6.32",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
